# Placement Preparation Command Centre - Environment Configuration
# Copy this file to .env to configure your local environment:
# copy .env.example .env

# Server Configuration
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=placement_command_centre.db

# -------------------------------------------------------------
# AI LLM API CONFIGURATION
# -------------------------------------------------------------
# Choose your active AI provider: "gemini" | "openai" | "groq"
ACTIVE_AI_PROVIDER=gemini

# 1. Google Gemini API (Recommended: Free tier, ultra-fast latency)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# 2. OpenAI API
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 3. Groq Cloud (Ultra-fast open models like Llama 3.3 70B)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=

# Note: You can also configure your API keys directly inside the application UI
# via the "Settings & Backup" navigation tab.
